<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Facturation.ViewModels"
             xmlns:m="using:GestionCommerciale.Modules.Tiers.Models"
             xmlns:cat="using:GestionCommerciale.Shared.Helpers"
             x:Class="GestionCommerciale.Modules.Facturation.Views.AvoirEditView"
             x:Name="ThisView"
             x:DataType="vm:AvoirEditViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding BtnBack}" Command="{Binding BackCommand}"/>
        <Button Content="{Binding BtnSave}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEditDraft}"/>
        <Button Content="{Binding BtnPdf}" Command="{Binding ExportPdfCommand}"/>
        <Button Content="{Binding BtnPrint}" Command="{Binding PrintCommand}"/>
      </StackPanel>
      <Border Background="{DynamicResource CourseraSurfaceBrush}" CornerRadius="8,8,0,0" Padding="10,8">
        <Border.ContextMenu>
          <ContextMenu Opening="OnHeaderContextMenuOpening">
            <MenuItem Header="{Binding MenuDeleteAvoir}" Command="{Binding RemoveAvoirCommand}"/>
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <TextBlock Grid.Column="0"
                     Text="{Binding Numero}"
                     FontWeight="Bold"
                     FontSize="16"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding LblClient}" VerticalAlignment="Center" Opacity="0.7"/>
            <AutoCompleteBox MinWidth="200"
                             MaxWidth="420"
                             VerticalAlignment="Center"
                             MinimumPrefixLength="1"
                             MaxDropDownHeight="320"
                             Watermark="{Binding WmClientSearch}"
                             ItemsSource="{Binding Clients}"
                             ItemFilter="{Binding PartyAutocompleteFilter}"
                             SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                             IsEnabled="{Binding CanEditDraft}">
              <AutoCompleteBox.ValueMemberBinding>
                <Binding Path="Nom"/>
              </AutoCompleteBox.ValueMemberBinding>
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate DataType="m:Tiers">
                  <TextBlock Text="{Binding Nom}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0">
            <TextBlock Text="{Binding LblDateAvoir}" VerticalAlignment="Center" Opacity="0.7"/>
            <DatePicker SelectedDate="{Binding Date}"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding LblAddProduct}" VerticalAlignment="Center" Opacity="0.7"/>
        <AutoCompleteBox MinWidth="360" MaxWidth="520" VerticalAlignment="Center"
                         MinimumPrefixLength="1" MaxDropDownHeight="320"
                         Watermark="{Binding WmAddProduct}"
                         ItemsSource="{Binding AddLineSearchResults}"
                         ItemFilter="{x:Static cat:DocumentCatalogAutoComplete.ItemFilter}"
                         cat:DocumentCatalogAutoComplete.ClearTextAfterPick="True"
                         Text="{Binding AddLineSearchText, Mode=TwoWay}"
                         SelectedItem="{Binding AddLineCatalogPick, Mode=TwoWay}"
                         IsEnabled="{Binding CanEditDraft}">
          <AutoCompleteBox.ValueMemberBinding>
            <Binding Path="Reference"/>
          </AutoCompleteBox.ValueMemberBinding>
          <AutoCompleteBox.ItemTemplate>
            <DataTemplate DataType="cat:DocumentCatalogItem">
              <TextBlock TextWrapping="Wrap" Text="{Binding DisplayLabel}"/>
            </DataTemplate>
          </AutoCompleteBox.ItemTemplate>
        </AutoCompleteBox>
        <Button Content="{Binding BtnRemoveLine}" Command="{Binding RemoveSelectedLineCommand}" IsEnabled="{Binding CanEditDraft}"/>
      </StackPanel>
      <Border BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8"
              Background="{DynamicResource CourseraSurfaceBrush}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource CourseraSurfaceMutedBrush}" Padding="8,8"
                  CornerRadius="8,8,0,0">
            <Grid ColumnDefinitions="*,140,90,110,110">
              <TextBlock Grid.Column="0" Text="{Binding LblDocColDesignation}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding LblDocColCond}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="2" Text="{Binding LblDocColQte}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="3" Text="{Binding LblDocColPrice}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="4" Text="{Binding LblDocColTotal}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Lignes}" SelectedItem="{Binding SelectedLine}" MinHeight="200"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:AvoirLineRow">
                <Border Padding="6,2" BorderBrush="#18000000" BorderThickness="0,0,0,1">
                  <Grid MinHeight="34" ColumnDefinitions="*,140,90,110,110">
                    <TextBox Grid.Column="0"
                             Text="{Binding Designation}"
                             Watermark="…"
                             Padding="6,4"
                             Margin="0,0,8,0"
                             IsReadOnly="{Binding !$parent[UserControl].((vm:AvoirEditViewModel)DataContext).CanEditDraft}"/>
                    <TextBox Grid.Column="1" Text="{Binding Conditionnement}"
                             Watermark="{Binding $parent[UserControl].((vm:AvoirEditViewModel)DataContext).WmDocLineUnite}"
                             Padding="6,4" Margin="0,0,8,0"
                             IsReadOnly="{Binding !$parent[UserControl].((vm:AvoirEditViewModel)DataContext).CanEditDraft}"/>
                    <NumericUpDown Grid.Column="2" ShowButtonSpinner="False" Value="{Binding Quantite}" FormatString="0.##" Minimum="0" Increment="1"
                                   HorizontalAlignment="Stretch" Margin="0,0,8,0"
                                   IsEnabled="{Binding $parent[UserControl].((vm:AvoirEditViewModel)DataContext).CanEditDraft}"/>
                    <NumericUpDown Grid.Column="3" ShowButtonSpinner="False" Value="{Binding PrixUnitaireHt}" FormatString="0.##" Minimum="0" Increment="0.01"
                                   HorizontalAlignment="Stretch" Margin="0,0,8,0"
                                   IsEnabled="{Binding $parent[UserControl].((vm:AvoirEditViewModel)DataContext).CanEditDraft}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Montant, StringFormat=\{0:N2\}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Opacity="0.9"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Grid Margin="0,8,0,0" ColumnDefinitions="*,16,Auto">
        <CheckBox Grid.Column="0"
                  Content="{Binding ChkRetourStock}"
                  IsChecked="{Binding RetourMarchandise}"
                  VerticalAlignment="Top"
                  IsEnabled="{Binding CanEditDraft}"/>
        <Border Grid.Column="2"
                Padding="14,10"
                MinWidth="220"
                VerticalAlignment="Top"
                Background="#EEF2FF"
                BorderBrush="#C7D2FE"
                BorderThickness="1"
                CornerRadius="6"
                BoxShadow="0 1 4 0 #18000000">
          <StackPanel Spacing="6" HorizontalAlignment="Right">
            <TextBlock Text="{Binding LblTotals}" FontSize="11" Opacity="0.65" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding TotalTtcLabel}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#3730A3"
                       HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

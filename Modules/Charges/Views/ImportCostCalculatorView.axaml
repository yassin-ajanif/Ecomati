<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Charges.ViewModels"
             x:Class="GestionCommerciale.Modules.Charges.Views.ImportCostCalculatorView"
             x:Name="ThisView"
             x:DataType="vm:ImportCostCalculatorViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12" Margin="4,8,4,32">
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Padding="10,6" CornerRadius="6" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
          <TextBlock Text="{Binding LblHelp}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
        </Border>
        <Border Padding="10,6" CornerRadius="6" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1">
          <TextBlock Text="{Binding LblFormula}" FontSize="12" FontWeight="SemiBold" Foreground="#3730A3"/>
        </Border>
        <Border Padding="10,6" CornerRadius="6" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
          <TextBlock Text="{Binding LblFormulaProduct}" FontSize="12" FontWeight="SemiBold" Foreground="#065F46"/>
        </Border>
      </StackPanel>

      <Grid ColumnDefinitions="*,16,*,16,*,16,*">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LblGros}" FontWeight="SemiBold" FontSize="12"/>
          <Grid ColumnDefinitions="*,Auto">
            <NumericUpDown Value="{Binding GrosPrice}" FormatString="N2" Minimum="0" Increment="1"
                           HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Devise}" VerticalAlignment="Center" Opacity="0.75" FontWeight="SemiBold"/>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="{Binding LblRmb}" FontWeight="SemiBold" FontSize="12"/>
          <Grid ColumnDefinitions="*,Auto">
            <NumericUpDown Value="{Binding UnitPriceRmb}" FormatString="N2" Minimum="0" Increment="0.01"
                           HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding RmbCurrency}" VerticalAlignment="Center" Opacity="0.75" FontWeight="SemiBold"/>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="4" Spacing="4">
          <TextBlock Text="{Binding LblMarketPrice}" FontWeight="SemiBold" FontSize="12"/>
          <NumericUpDown Value="{Binding MarketPrice}" FormatString="N2" Minimum="0" Increment="0.01"
                         HorizontalAlignment="Stretch"/>
        </StackPanel>
        <StackPanel Grid.Column="6" Spacing="4">
          <TextBlock Text="{Binding LblCoefficient}" FontWeight="SemiBold" FontSize="12"/>
          <Border Padding="12,6" MinHeight="32" CornerRadius="8"
                  Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding CoefficientLabel}" FontWeight="Bold" FontSize="18"
                       VerticalAlignment="Center" Foreground="#3730A3"/>
          </Border>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,16,300">
        <Border BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8"
                Background="{DynamicResource CourseraSurfaceBrush}">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource CourseraSurfaceMutedBrush}" Padding="8,6"
                    CornerRadius="8,8,0,0">
              <Grid ColumnDefinitions="Auto,*,140,44,Auto,40">
                <TextBlock Grid.Column="0" Text="{Binding LblExpenses}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="{Binding BtnAddExpense}" Command="{Binding AddExpenseCommand}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4"/>
                <TextBlock Grid.Column="2" Text="{Binding LblExpenseAmount}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="{Binding Devise}" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.75"/>
              </Grid>
            </Border>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Expenses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ImportCostExpenseRow">
                  <Border Padding="6,4" BorderBrush="#18000000" BorderThickness="0,0,0,1">
                    <Grid MinHeight="34" ColumnDefinitions="*,140,44,40">
                      <TextBox Grid.Column="0" Text="{Binding Libelle}" Padding="6,4" Margin="0,0,8,0"
                               Watermark="{Binding $parent[UserControl].((vm:ImportCostCalculatorViewModel)DataContext).LblExpenseLabel}"/>
                      <NumericUpDown Grid.Column="1" ShowButtonSpinner="False" Value="{Binding Montant}"
                                     FormatString="N2" Minimum="0" Increment="1"
                                     HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                      <TextBlock Grid.Column="2" Text="{Binding $parent[UserControl].((vm:ImportCostCalculatorViewModel)DataContext).Devise}"
                                 VerticalAlignment="Center" Opacity="0.75"/>
                      <Button Grid.Column="3"
                              ToolTip.Tip="{Binding $parent[UserControl].((vm:ImportCostCalculatorViewModel)DataContext).BtnRemove}"
                              Command="{Binding $parent[UserControl].((vm:ImportCostCalculatorViewModel)DataContext).RemoveExpenseCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent" BorderThickness="0" Padding="4"
                              Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14">
                          <Path Fill="{DynamicResource CourseraDangerBrush}"
                                Data="M6,7 L6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 Z"/>
                        </Viewbox>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Border Grid.Column="2" Padding="14,12"
                VerticalAlignment="Top"
                Background="#EEF2FF"
                BorderBrush="#C7D2FE"
                BorderThickness="1"
                CornerRadius="6"
                BoxShadow="0 1 4 0 #18000000">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding LblSumExpenses}" Opacity="0.7"/>
              <TextBlock Grid.Column="1" Text="{Binding SumExpensesLabel}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding LblCoefficient}" Opacity="0.7"/>
              <TextBlock Grid.Column="1" Text="{Binding CoefficientLabel}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </Grid>
            <Border Height="1" Background="#C7D2FE" Opacity="0.6"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding LblProductPrice}" FontWeight="Bold" FontSize="14"/>
              <TextBlock Grid.Column="1" Text="{Binding ProductPriceLabel}" FontWeight="Bold" FontSize="18"
                         Foreground="#3730A3" HorizontalAlignment="Right"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasMargin}">
              <TextBlock Text="{Binding LblMargin}" FontWeight="Bold" FontSize="14"/>
              <TextBlock Grid.Column="1" Text="{Binding MarginLabel}" FontWeight="Bold" FontSize="18"
                         Foreground="#15803D" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding LblTableTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Content="{Binding BtnAddRow}" Command="{Binding AddTableRowCommand}"/>
      </StackPanel>

      <Border BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8"
              Background="{DynamicResource CourseraSurfaceBrush}" HorizontalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch">
          <Border Grid.Row="0" Background="{DynamicResource CourseraSurfaceMutedBrush}" Padding="8,8"
                  CornerRadius="8,8,0,0">
            <Grid ColumnDefinitions="1.8*,0.7*,0.7*,0.95*,0.9*,0.75*,0.65*,0.9*,0.7*,1.35*,1.35*,1.35*,28">
              <TextBlock Grid.Column="0" Text="{Binding ColReference}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding ColPm}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding ColPc}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Border Grid.Column="3" Background="#FEF9C3" CornerRadius="4" Padding="2,2" Margin="0,0,4,0">
                <TextBlock Text="{Binding ColRmb}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <Border Grid.Column="4" Background="#FEF9C3" CornerRadius="4" Padding="2,2" Margin="0,0,4,0">
                <TextBlock Text="{Binding ColLaDouane}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <Border Grid.Column="5" Background="#FEF9C3" CornerRadius="4" Padding="2,2" Margin="0,0,4,0">
                <TextBlock Text="{Binding ColM}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock Grid.Column="6" Text="{Binding ColCntPs}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Border Grid.Column="7" Background="#FEF9C3" CornerRadius="4" Padding="2,2" Margin="0,0,4,0">
                <TextBlock Text="{Binding ColTm}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock Grid.Column="8" Text="{Binding ColCntColis}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Border Grid.Column="9" Background="#FEF9C3" CornerRadius="4" Padding="2,2" Margin="0,0,4,0">
                <TextBlock Text="{Binding ColMNet}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <Border Grid.Column="10" Background="#FEF9C3" CornerRadius="4" Padding="2,2" Margin="0,0,4,0">
                <TextBlock Text="{Binding ColCa}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <Border Grid.Column="11" Background="#FEF9C3" CornerRadius="4" Padding="2,2" Margin="0,0,4,0">
                <TextBlock Text="{Binding ColTMarge}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding TableRows}" HorizontalAlignment="Stretch">
            <ItemsControl.Styles>
              <Style Selector="ItemsControl > ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ImportCostTableRow">
                <Border Padding="6,4" BorderBrush="#18000000" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
                  <Grid MinHeight="34" ColumnDefinitions="1.8*,0.7*,0.7*,0.95*,0.9*,0.75*,0.65*,0.9*,0.7*,1.35*,1.35*,1.35*,28" HorizontalAlignment="Stretch">
                    <TextBox Grid.Column="0" Text="{Binding Reference}" Padding="4,2" Margin="0,0,4,0"
                             HorizontalAlignment="Stretch"/>
                    <NumericUpDown Grid.Column="1" ShowButtonSpinner="False" Value="{Binding Pm}" FormatString="N2"
                                   Minimum="0" Increment="0.01" Margin="0,0,3,0" HorizontalAlignment="Stretch"/>
                    <NumericUpDown Grid.Column="2" ShowButtonSpinner="False" Value="{Binding Pc}" FormatString="N2"
                                   Minimum="0" Increment="0.01" Margin="0,0,3,0" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Column="3" ColumnDefinitions="*,Auto" Margin="0,0,3,0">
                      <NumericUpDown ShowButtonSpinner="False" Value="{Binding Rmb}" FormatString="N2"
                                     Minimum="0" Increment="0.01" HorizontalAlignment="Stretch"
                                     Background="#FEF9C3"/>
                      <Button Grid.Column="1"
                              ToolTip.Tip="{Binding $parent[UserControl].((vm:ImportCostCalculatorViewModel)DataContext).TipCalcRmb}"
                              Command="{Binding $parent[UserControl].((vm:ImportCostCalculatorViewModel)DataContext).CalculateRmbCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent" BorderThickness="0" Padding="1"
                              Width="22" Height="22" VerticalAlignment="Center">
                        <Viewbox Width="12" Height="12">
                          <Path Fill="#3730A3"
                                Data="M4,2 L16,2 C17.1,2 18,2.9 18,4 L18,16 C18,17.1 17.1,18 16,18 L4,18 C2.9,18 2,17.1 2,16 L2,4 C2,2.9 2.9,2 4,2 Z M5,5 L15,5 L15,7 L5,7 Z M5,9 L9,9 L9,11 L5,11 Z M11,9 L15,9 L15,11 L11,11 Z M5,13 L9,13 L9,15 L5,15 Z M11,13 L15,13 L15,15 L11,15 Z"/>
                        </Viewbox>
                      </Button>
                    </Grid>
                    <NumericUpDown Grid.Column="4" ShowButtonSpinner="False" Value="{Binding LaDouane}" FormatString="N2"
                                   Minimum="0" Increment="0.01" Margin="0,0,3,0" HorizontalAlignment="Stretch"
                                   Background="#FEF9C3" IsEnabled="False"/>
                    <NumericUpDown Grid.Column="5" ShowButtonSpinner="False" Value="{Binding M}" FormatString="N2"
                                   Increment="0.01" Margin="0,0,3,0" HorizontalAlignment="Stretch"
                                   Background="#FEF9C3" IsEnabled="False"/>
                    <NumericUpDown Grid.Column="6" ShowButtonSpinner="False" Value="{Binding CntPs}" FormatString="N0"
                                   Minimum="0" Increment="1" Margin="0,0,3,0" HorizontalAlignment="Stretch"/>
                    <NumericUpDown Grid.Column="7" ShowButtonSpinner="False" Value="{Binding Tm}" FormatString="N2"
                                   Increment="1" Margin="0,0,3,0" HorizontalAlignment="Stretch"
                                   Background="#FEF9C3" IsEnabled="False"/>
                    <NumericUpDown Grid.Column="8" ShowButtonSpinner="False" Value="{Binding CntColis}" FormatString="N0"
                                   Minimum="0" Increment="1" Margin="0,0,3,0" HorizontalAlignment="Stretch"/>
                    <NumericUpDown Grid.Column="9" ShowButtonSpinner="False" Value="{Binding MNet}" FormatString="N2"
                                   Increment="1" Margin="0,0,2,0" HorizontalAlignment="Stretch"
                                   Background="#FEF9C3" IsEnabled="False"/>
                    <NumericUpDown Grid.Column="10" ShowButtonSpinner="False" Value="{Binding Ca}" FormatString="N2"
                                   Increment="1" Margin="0,0,2,0" HorizontalAlignment="Stretch"
                                   Background="#FEF9C3" IsEnabled="False"/>
                    <NumericUpDown Grid.Column="11" ShowButtonSpinner="False" Value="{Binding TMarge}" FormatString="N2"
                                   Increment="1" Margin="0,0,2,0" HorizontalAlignment="Stretch"
                                   Background="#FEF9C3" IsEnabled="False"/>
                    <Button Grid.Column="12"
                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ImportCostCalculatorViewModel)DataContext).BtnRemove}"
                            Command="{Binding $parent[UserControl].((vm:ImportCostCalculatorViewModel)DataContext).RemoveTableRowCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0">
                      <Viewbox Width="12" Height="12">
                        <Path Fill="{DynamicResource CourseraDangerBrush}"
                              Data="M6,7 L6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 Z"/>
                      </Viewbox>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
